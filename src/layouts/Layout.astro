---
import { site } from "../config";
import "../styles/themes.css";
const { title = site.name } = Astro.props;
const path = Astro.url.pathname;
const tabs = site.tabs;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,400;9..144,600;9..144,700&family=Manrope:wght@300;400;500;600&display=swap" rel="stylesheet" />
  </head>
  <body>
    <header>
      <h1>Nazim</h1>
      <nav>
        {tabs.map((t) => (
          <a href={t.href} class={(t.href === "/" ? path === "/" : path.startsWith(t.href)) ? "active" : ""}>{t.label}</a>
        ))}
      </nav>
    </header>
    <main><slot /></main>
  </body>
</html>

<style is:global>
  :root { --primary: #1e3a8a; --bg: #f7f5f0; --text: #1a1a1a; --muted: #6b6b6b; --accent: #c9a227; }
  * { box-sizing: border-box; }
  body { margin: 0; font-family: 'Manrope', system-ui, sans-serif; background: var(--bg); color: var(--text); padding-bottom: 72px; line-height: 1.6; }
  header { padding: 2rem 1.5rem 1rem; max-width: 960px; margin: 0 auto; }
  h1 { margin: 0; font-family: 'Fraunces', serif; font-size: 2rem; color: var(--primary); letter-spacing: -0.02em; }
  main { padding: 1rem 1.5rem 3rem; max-width: 760px; margin: 0 auto; animation: fadeUp .6s ease both; }
  h2 { font-family: 'Fraunces', serif; font-size: 2rem; margin: 0 0 1rem; }
  h3 { font-family: 'Fraunces', serif; font-size: 1.3rem; margin: 1.5rem 0 .25rem; }
  a { color: var(--primary); }
  article { padding: 1.25rem 0; border-bottom: 1px solid #e5e1d8; animation: fadeUp .5s ease both; }
  small { color: var(--muted); }
  nav { position: fixed; bottom: 0; left: 0; right: 0; display: flex; background: rgba(247,245,240,.92); backdrop-filter: blur(8px); border-top: 1px solid #e5e1d8; z-index: 10; }
  nav a { flex: 1; text-align: center; padding: 1rem 0; text-decoration: none; color: var(--muted); font-size: .85rem; transition: color .2s, transform .2s; }
  nav a.active { color: var(--primary); font-weight: 600; border-top: 2px solid var(--primary); }
  nav a:hover { transform: translateY(-2px); }
  @media (min-width: 768px) {
    body { padding-bottom: 0; }
    header { display: flex; justify-content: space-between; align-items: center; }
    nav { position: static; border: 0; background: transparent; backdrop-filter: none; }
    nav a { padding: .5rem 1rem; font-size: 1rem; }
    nav a.active { border-top: 0; border-bottom: 2px solid var(--primary); }
  }
  @keyframes fadeUp { from { opacity: 0; transform: translateY(12px); } to { opacity: 1; transform: none; } }
</style>